// =========================================================================
// MH2M Full Implementation for Darcy Flow (Pure Diffusion, Asymmetric Formulation)
// =========================================================================

include "getARGV.idp"
load "Element_P3"
load "iovtk"
load "qf11to25"
load "msh3"

// Command line arguments
int coarseMesh = getARGV("-cM", 2);  
int subMesh = getARGV("-subM", 0);   
int edgeMesh = getARGV("-edgeM", 0); 
int PkOrder = getARGV("-PkO", 2);    
int lOrder = getARGV("-lOr", 1);      
int mOrder = getARGV("-mOr", 1);      
int exportVTKlocal = getARGV("-vtk", 0); 

// Results folders
string directory = "mh2mDiff-cM"+coarseMesh+"-eM"+edgeMesh+"-sM"+subMesh+"-L"+lOrder+"-K"+PkOrder;
exec("mkdir -p " + directory);

// Polynomial spaces
func Pl = P2dc; // Local multipliers
func Pm = P3;   // Global trace
func Pk = P3;   // Local volume

real tol = 1e-12;

// =========================================================================
// Global Mesh and Trace Space
// =========================================================================
real x0 = 0.0, x1 = 1.0;
real y0 = 0.0, y1 = 1.0;
int globalH = 2^coarseMesh;
mesh calP = square(globalH, globalH, [x0 + (x1 - x0)*x, y0 + (y1 - y0)*y]);

int NbTriangles = calP.nt;
int NbVertices = calP.nv;

fespace TraceSpace(calP, Pm); 
int numTraceDofs = TraceSpace.ndof;
int nLocalTraceDofs = TraceSpace.ndofK; 

// Analytical Functions
func uExact = sin(2*pi*x)*sin(pi*y);
func dxuExact = 2*pi*cos(2*pi*x)*sin(pi*y);
func dyuExact = pi*sin(2*pi*x)*cos(pi*y);
func f = 5.0*(pi^2)*sin(2*pi*x)*sin(pi*y); 

// =========================================================================
// Local Meshes
// =========================================================================
meshL[int] EdgeH(NbTriangles);
mesh[int] Th(NbTriangles);

int[int] edgeLabel = [11, 22, 33]; 

for(int K = 0; K < NbTriangles; K++){
    real coordX0 = calP[K][0].x; 
    real coordY0 = calP[K][0].y;
    real coordX1 = calP[K][1].x; 
    real coordY1 = calP[K][1].y;
    real coordX2 = calP[K][2].x; 
    real coordY2 = calP[K][2].y;

    border f0(t=0,1){P.x=coordX1+t*(coordX2-coordX1); P.y=coordY1+t*(coordY2-coordY1); label=11;}
    border f1(t=0,1){P.x=coordX2+t*(coordX0-coordX2); P.y=coordY2+t*(coordY0-coordY2); label=22;}
    border f2(t=0,1){P.x=coordX0+t*(coordX1-coordX0); P.y=coordY0+t*(coordY1-coordY0); label=33;}

    mesh ThK = buildmesh(f0(1) + f1(1) + f2(1));
    mesh ThKminimal = trunc(ThK, 1, split=2^edgeMesh);
    EdgeH[K] = extract(ThKminimal, label=edgeLabel);   
    Th[K] = trunc(ThKminimal, 1, split=2^subMesh);
}

// =========================================================================
// Offline Stage
// =========================================================================
fespace VhK0(Th[0], Pk);
int ndofVhK = VhK0.ndof;
// Dynamically calculate the exact number of multiplier DOFs per element
fespace LhK0(EdgeH[0], Pl);
int maxLam = LhK0.ndof;

real[int,int] EtaMatall(NbTriangles * ndofVhK, maxLam);
real[int,int] etafall(NbTriangles, ndofVhK);
real[int,int] etaqall(NbTriangles, ndofVhK); // Storage for etaQ

real[int,int] Slamdaall(NbTriangles * maxLam, nLocalTraceDofs);
real[int] glamdaall(NbTriangles * maxLam);
real[int,int] v0Kall(NbTriangles, nLocalTraceDofs);

int maxNz = NbTriangles * (nLocalTraceDofs * nLocalTraceDofs) + 1;
int[int] Iglob(maxNz), Jglob(maxNz);
real[int] Cglob(maxNz);
real[int] Rglob(numTraceDofs); Rglob = 0.0;
int idxGlob = 0;


int countSingularInt = 0;
int countSingularExt = 0;


for(int K = 0; K < NbTriangles; K++){
    mesh auxTh = Th[K];
    meshL auxEh = EdgeH[K];

    fespace VhK(auxTh, Pk);
    fespace LhK(auxEh, Pl);
    fespace VhK1D(auxEh, Pk); // 1D restriction space for safe boundary integration
    
    int mLam = LhK.ndof;
    int mFluct = mLam - 1; 

    real dKarea = int1d(auxEh)(1.0); // Exact boundary length
    
    // Safely map 2D continuous volume functions to 1D boundary functions
    matrix Id = interpolate(VhK1D, VhK); 

    // =========================================================================
    // 1. Z matrix to enforce zero average (Strictly on 1D mesh)
    // =========================================================================
    varf vAvgF(unused, psi) = int1d(auxEh)(psi * 1.0);
    real[int] vAvg = vAvgF(0, LhK);
    
    int j0 = 0;
    for(int i=1; i<mLam; i++) if(abs(vAvg[i]) > abs(vAvg[j0])) j0 = i;
    
    real[int,int] Z(mLam, mFluct);
    int colIdx = 0;
    for(int i=0; i<mLam; i++){
        if(i == j0) continue;
        for(int r=0; r<mLam; r++) Z(r, colIdx) = 0.0;
        Z(i, colIdx) = 1.0;
        Z(j0, colIdx) = -vAvg[i] / vAvg[j0]; 
        colIdx++;
    }
    matrix Zmat = Z;

    // =========================================================================
    // 2. Local Saddle-Point Operator
    // =========================================================================
    varf vAk(u, v) = int2d(auxTh)(dx(u)*dx(v) + dy(u)*dy(v));
    matrix Ak = vAk(VhK, VhK);
    
    // Compute Bc strictly on the 1D mesh to guarantee zero-mean exactness
    varf vBc1D(unused, v) = int1d(auxEh)(v * 1.0); 
    real[int] Bc1D = vBc1D(0, VhK1D);
    real[int] Bc = Id' * Bc1D;
    
    matrix AAk = [ [Ak, Bc], [Bc', 0] ];
    set(AAk, solver=sparsesolver);

    // =========================================================================
    // 3. Computation of local sources (eta_f and eta_Q)
    // =========================================================================
    varf vF(unused, v) = int2d(auxTh)(f * v);
    real[int] RHSf = vF(0, VhK);
    real[int] RHSfaug(VhK.ndof + 1);
    for(int d=0; d<VhK.ndof; d++) RHSfaug[d] = RHSf[d]; 
    RHSfaug[VhK.ndof] = 0.0;
    
    real[int] solf = AAk^-1 * RHSfaug;
    for(int d=0; d<VhK.ndof; d++) etafall(K, d) = solf[d];

    varf vQ(unused, v) = int2d(auxTh)(1.0 * v);
    real[int] RHSq = vQ(0, VhK);
    real[int] RHSqaug(VhK.ndof + 1);
    for(int d=0; d<VhK.ndof; d++) RHSqaug[d] = RHSq[d];
    RHSqaug[VhK.ndof] = 0.0;
    
    real[int] solq = AAk^-1 * RHSqaug;
    for(int d=0; d<VhK.ndof; d++) etaqall(K, d) = solq[d];

    // =========================================================================
    // Computation of fluctuation basis functions (Using varf on auxTh to respect subM)
    // =========================================================================
    real[int, int] Fkl(ndofVhK, mFluct);
    
    for(int j=0; j<mFluct; j++){
        LhK Phij; Phij[] = 0; 
        for(int r=0; r<mLam; r++) Phij[][r] = Z(r,j); 
        
        varf fhKl11(unused, varphi) = int1d(auxTh, 11)(Phij * varphi);
        varf fhKl22(unused, varphi) = int1d(auxTh, 22)(Phij * varphi);
        varf fhKl33(unused, varphi) = int1d(auxTh, 33)(Phij * varphi);
        
        real[int] vecJ11 = fhKl11(0, VhK);
        real[int] vecJ22 = fhKl22(0, VhK);
        real[int] vecJ33 = fhKl33(0, VhK);
        
        for(int i=0; i<ndofVhK; i++) Fkl(i,j) = vecJ11[i] + vecJ22[i] + vecJ33[i];
    }

    real[int,int] EtaMat(VhK.ndof, mFluct);
    for(int j=0; j<mFluct; j++){
        real[int] rhsCol = Fkl(:, j);
        real[int] rhsAug(ndofVhK + 1);
        for(int d=0; d<ndofVhK; d++) rhsAug[d] = -rhsCol[d]; 
        rhsAug[ndofVhK] = 0.0;
        
        real[int] solpsi = AAk^-1 * rhsAug;
        for(int d=0; d<VhK.ndof; d++){
            EtaMat(d, j) = solpsi[d];
            EtaMatall(K*ndofVhK + d, j) = solpsi[d];
        }
    }

    // =========================================================================
    // Algebraic Construction of Local Operators (Exact and Lightning Fast)
    // =========================================================================
    real[int,int] matAKalg(mFluct, mFluct);
    for(int i=0; i<mFluct; i++){
        real[int] Fi = Fkl(:, i);
        for(int j=0; j<mFluct; j++){
            real[int] etaj = EtaMat(:, j);
            matAKalg(i, j) = Fi' * etaj; // A_{ij} = <psi_i, eta_j>
        }
    }
    
    matrix matAK = matAKalg;
    set(matAK, solver=sparsesolver);

    // =========================================================================
    // Assembly of Local Schur Complement Mappings
    // =========================================================================
    int[int] mDofs(nLocalTraceDofs);
    for(int j = 0; j < nLocalTraceDofs; j++) mDofs[j] = TraceSpace(K, j);

    real[int,int] MrhoK(mFluct, nLocalTraceDofs);
    for(int j=0; j<nLocalTraceDofs; j++){
        TraceSpace xiMac = 0; xiMac[][ mDofs[j] ] = 1.0;
        VhK xiLocal = xiMac; 
        
        v0Kall(K, j) = (Bc' * xiLocal[]) / dKarea; 
        
        for(int i=0; i<mFluct; i++){
            real[int] Fi = Fkl(:, i);
            MrhoK(i, j) = Fi' * xiLocal[]; // Mrho_{ij} = <psi_i, xi_j>
        }
    }

    real[int] efK(mFluct), eqK(mFluct);
    real[int] etaf = etafall(K, :), etaq = etaqall(K, :);
    for(int i=0; i<mFluct; i++){
        real[int] Fi = Fkl(:, i);
        efK[i] = Fi' * etaf; 
        eqK[i] = Fi' * etaq; 
    }

    // Condensation operators
    real[int,int] Slam(mFluct, nLocalTraceDofs);
    for(int j=0; j<nLocalTraceDofs; j++){
        real[int] colVec(mFluct);
        for(int i=0; i<mFluct; i++) colVec[i] = MrhoK(i, j) - eqK[i] * v0Kall(K, j);
        real[int] solCol = matAK^-1 * colVec;
        for(int i=0; i<mFluct; i++){
            Slam(i, j) = solCol[i];
            Slamdaall(K*maxLam + i, j) = solCol[i];
        }
    }
    
    real[int] glam = matAK^-1 * efK; glam *= -1.0;
    for(int i=0; i<mFluct; i++) glamdaall[K*maxLam + i] = glam[i];

    // Global Assembly (sin advección)
    real g0K = (1.0 / dKarea) * int2d(auxTh)(f);
    real[int,int] SK(nLocalTraceDofs, nLocalTraceDofs);
    real[int] RK(nLocalTraceDofs);
    
    for(int i=0; i<nLocalTraceDofs; i++){
        RK[i] = - g0K * v0Kall(K, i);
        for(int k=0; k<mFluct; k++) RK[i] += -MrhoK(k, i) * glam[k];
        for(int j=0; j<nLocalTraceDofs; j++){
            SK(i,j) = 0.0;
            for(int k=0; k<mFluct; k++) SK(i,j) += MrhoK(k, i) * Slam(k, j);
        }
    }
    
    for(int i=0; i<nLocalTraceDofs; i++){
        int gi = mDofs[i];
        Rglob[gi] += RK[i]; 
        for(int j=0; j<nLocalTraceDofs; j++){
            Iglob[idxGlob] = gi;
            Jglob[idxGlob] = mDofs[j];
            Cglob[idxGlob] = SK(i,j); 
            idxGlob++;
        }
    }
} 

